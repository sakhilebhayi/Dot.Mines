APP_NAME=Mines
APP_ENV=local
APP_KEY=base64:E4LEFBChUFxBdwEJu1pO1h15PQYUrY0Hlr5ftGzUJ5I=
APP_DEBUG=true
APP_URL=https://mines.infodot.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
#
# Production overrides (set these in your production .env):
#   SESSION_ENCRYPT=true           # Encrypt session data at rest
#   SESSION_SECURE_COOKIE=true     # HTTPS-only cookie flag
#   SESSION_SAME_SITE=strict       # Block cross-site request forgery vectors

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION OVERRIDES
# For Docker / cloud deployments, override these values:
#
#   SESSION_DRIVER=redis           # Enables horizontal scaling of sessions
#   SESSION_ENCRYPT=true           # Encrypt session cookies at rest
#   SESSION_SECURE_COOKIE=true     # HTTPS-only cookies
#   SESSION_SAME_SITE=strict       # CSRF protection
#   CACHE_STORE=redis              # Distributed cache (required for multi-node)
#   QUEUE_CONNECTION=redis         # Redis queue (faster + reliable)
# ──────────────────────────────────────────────────────────────────────────────

BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
FEED_ATTACHMENT_DISK=public
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis    # Use redis in production

# Pusher Configuration
PUSHER_APP_ID=2110946
PUSHER_APP_KEY=54b7c09b361c08f04667
PUSHER_APP_SECRET=726439f2da574026ebb2
PUSHER_APP_CLUSTER=ap2

# Reverb Broadcasting Configuration (disabled - requires PCNTL)
REVERB_APP_ID=1
REVERB_APP_KEY=Tg8vE1ptCC0/yKMjopOjszAHgeWLVzC9e17ANzWQwTk=
REVERB_APP_SECRET=default-app-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_STORE=redis    # Use redis in production
# CACHE_PREFIX=mines_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set MAIL_MAILER=smtp and fill in credentials to send real email.
# Production uses mines.infodot.co.za:465 (SSL) — see .env.production.example.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@mines.infodot.co.za"
MAIL_FROM_ADDRESS_SUPPORT="support@mines.infodot.co.za"
MAIL_FROM_ADDRESS_BILLING="billing@mines.infodot.co.za"
MAIL_FROM_ADDRESS_PRIVACY="privacy@mines.infodot.co.za"
MAIL_FROM_ADDRESS_LEGAL="legal@mines.infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=${APP_URL}/billing/success
PAYSTACK_WEBHOOK_URL=${APP_URL}/webhooks/paystack

PAYSTACK_BASIC_MONTHLY_PLAN_CODE=
PAYSTACK_BASIC_YEARLY_PLAN_CODE=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_MONTHLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_YEARLY_PLAN_CODE=

VITE_APP_NAME="${APP_NAME}"

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Sentry Error Monitoring ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
# Enable distributed tracing in production (0.0 = off, 0.1 = 10% sample rate)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── API ──────────────────────────────────────────────────────────────────────
API_VERSION=1.0.0

# ── Laravel Horizon (Queue Dashboard) ────────────────────────────────────────
# Comma-separated admin emails that can view the Horizon dashboard
HORIZON_ADMINS=
HORIZON_NAME="${APP_NAME} Horizon"

# ── Laravel Pulse (Performance Dashboard) ────────────────────────────────────
PULSE_ENABLED=true
PULSE_PATH=pulse

# ── Bell Equipment Integration ────────────────────────────────────────────────
# SSO / OAuth2 — Password Credentials grant (Basic Auth header)
BELL_SSO_TOKEN_URL=
BELL_SSO_GRANT_TYPE=password
BELL_SSO_CLIENT_ID=
BELL_SSO_CLIENT_SECRET=
BELL_SSO_USERNAME=
BELL_SSO_PASSWORD=
BELL_SSO_SCOPE=ISO_Exports

# ISO15143-3 Fleet API (syncs every 15 minutes)
BELL_API_BASE_URL=
BELL_ISO15143_API_URL=
BELL_ISO15143_CLIENT_ID=
BELL_ISO15143_CLIENT_SECRET=
BELL_ISO15143_USERNAME=
BELL_ISO15143_PASSWORD=

# Historical Telemetry API (syncs hourly, 13 signals per machine)
BELL_HISTORICAL_BASE_URL="${BELL_API_BASE_URL}"
BELL_HISTORICAL_USERNAME="${BELL_ISO15143_USERNAME}"
BELL_HISTORICAL_PASSWORD="${BELL_ISO15143_PASSWORD}"
