<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
>
  <projectFiles>
    <directory name="app"/>
    <directory name="routes"/>
    <ignoreFiles>
      <directory name="vendor"/>
    </ignoreFiles>
  </projectFiles>

  <issueHandlers>
    <!-- Suppress issues that are known false positives in Laravel -->
    <MissingReturnType errorLevel="info"/>
    <MissingParamType errorLevel="info"/>
    <PropertyNotSetInConstructor errorLevel="info"/>
    <UnusedVariable errorLevel="info"/>

    <!-- Policy: this codebase keeps classes extendable by convention
         (documented on the Livewire components); "must be final" is a
         style opinion, not a defect class. -->
    <ClassMustBeFinal errorLevel="suppress"/>

    <!-- Dead-code detection stays ON (it has found real dead code), but
         framework-invoked classes are exempt: Blade templates, routes,
         the scheduler and the notification system call these, and psalm
         cannot see any of those callers. -->
    <PossiblyUnusedMethod>
      <errorLevel type="suppress">
        <!-- Models/Traits: relations, scopes and accessors are invoked
             through Eloquent magic and Blade. Events: broadcast lifecycle
             methods are called by the framework. Actions: registered with
             Fortify/Jetstream at boot. -->
        <directory name="app/Models"/>
        <directory name="app/Traits"/>
        <directory name="app/Events"/>
        <directory name="app/Actions"/>
        <directory name="app/Livewire"/>
        <directory name="app/Console/Commands"/>
        <directory name="app/Jobs"/>
        <directory name="app/Listeners"/>
        <directory name="app/Mail"/>
        <directory name="app/Notifications"/>
        <directory name="app/Policies"/>
        <directory name="app/View"/>
        <directory name="app/Http"/>
      </errorLevel>
    </PossiblyUnusedMethod>
    <PossiblyUnusedProperty>
      <errorLevel type="suppress">
        <!-- Jobs: $tries/$timeout/$backoff are read by the queue worker.
             Exceptions: payload properties are part of the throwing
             contract even when a given catch site reads only some. -->
        <directory name="app/Jobs"/>
        <directory name="app/Exceptions"/>
        <directory name="app/Events"/>
        <directory name="app/Livewire"/>
        <directory name="app/Mail"/>
        <directory name="app/Notifications"/>
        <directory name="app/Http"/>
      </errorLevel>
    </PossiblyUnusedProperty>
    <PossiblyUnusedParam>
      <errorLevel type="suppress">
        <!-- Controller actions, policy checks and notification builders
             implement fixed framework signatures (Request, User, notifiable);
             an unused parameter there is contract, not dead code. -->
        <directory name="app/Http"/>
        <directory name="app/Policies"/>
        <directory name="app/Notifications"/>
      </errorLevel>
    </PossiblyUnusedParam>
    <PossiblyUnusedReturnValue>
      <errorLevel type="suppress">
        <!-- Service and model helpers return the affected entity by
             convention (fluent create/update/delete APIs); callers are
             free to ignore the return without that being dead code. -->
        <directory name="app/Services"/>
        <directory name="app/Models"/>
      </errorLevel>
    </PossiblyUnusedReturnValue>
    <UnusedClass>
      <errorLevel type="suppress">
        <directory name="app/Livewire"/>
        <directory name="app/Console/Commands"/>
        <directory name="app/Jobs"/>
        <directory name="app/Listeners"/>
        <directory name="app/Mail"/>
        <directory name="app/Notifications"/>
        <directory name="app/Policies"/>
        <directory name="app/View"/>
        <directory name="app/Http"/>
        <directory name="app/Providers"/>
      </errorLevel>
    </UnusedClass>
  </issueHandlers>

  <plugins>
    <pluginClass class="Psalm\LaravelPlugin\Plugin"/>
  </plugins>
</psalm>
