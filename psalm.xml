<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    errorBaseline="psalm-baseline.xml"
>
  <projectFiles>
    <directory name="app" />
    <directory name="routes" />
    <ignoreFiles>
      <directory name="vendor" />
    </ignoreFiles>
  </projectFiles>

  <issueHandlers>
    <!-- Suppress issues that are known false positives in Laravel -->
    <MissingReturnType severity="info" />
    <MissingParamType severity="info" />
    <PropertyNotSetInConstructor severity="info" />
    <UnusedVariable severity="info" />
  </issueHandlers>
</psalm>
